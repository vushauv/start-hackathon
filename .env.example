# Copy to .env and adjust: cp .env.example .env
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=memory
# host port, bound to 127.0.0.1
POSTGRES_PORT=5432

# Optional FastAPI memory-api Docker profile. Reactor credentials belong in the
# file selected by REACTOR_ENV_FILE (never commit that file).
PIPELINE_API_PORT=8000
PIPELINE_SPLIT=dev
PIPELINE_DATA_DIR=./dev
PIPELINE_EVIDENCE_FILE=./pipeline/runs/dev/evidence.jsonl
# REACTOR_ENV_FILE=../.env
# Optional host-only provider credentials for the trace UI. These files are
# ignored and are mounted into the trace container by Docker Compose.
# OPENAI_ENV_FILE=./pipeline/.env.openai
# GROQ_ENV_FILE=./pipeline/.env.groq

# Loopback port for the optional Streamable HTTP MCP server.
MCP_PORT=8001

# Optional public Cloudflare Tunnel profile. This must be the connector token
# for a named tunnel, not a Cloudflare API token.
# CLOUDFLARE_TUNNEL_TOKEN=
