# Copy to .env and adjust: cp .env.example .env
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=memory
# host port, bound to 127.0.0.1
POSTGRES_PORT=5432

# Optional FastAPI memory-api Docker profile. Reactor credentials belong in the
# file selected by REACTOR_ENV_FILE (never commit that file).
PIPELINE_API_PORT=8000
PIPELINE_SPLIT=dev
PIPELINE_DATA_DIR=./dev
PIPELINE_EVIDENCE_FILE=./pipeline/runs/dev/evidence.jsonl
# REACTOR_ENV_FILE=../.env
