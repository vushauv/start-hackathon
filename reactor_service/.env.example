# Copy to .env and fill in from the organizers' handout: cp .env.example .env
REACTOR_BASE_URL=https://tNN.api.reactor-hackathon.rxai.dev
REACTOR_AGENT_ID=agt_xxxxxxxx
REACTOR_ACCESS_KEY=rxk_xxxxxxxx
# optional
REACTOR_TEAM_NAME=
REACTOR_SLOT=
# seconds to wait for an answer (default 300)
REACTOR_TIMEOUT=300
# client-side message size limit in characters (server limit is 32000)
REACTOR_MAX_CHARS=16000
